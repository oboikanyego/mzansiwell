{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": "src", "strict": true, "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true, "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
